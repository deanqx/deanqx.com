---
import Logo from "../assets/deanqx-kihim.svg";
---

<a class="title" aria-label="Logo to Home page" href="/"><Logo /></a>
<style>
  .title {
    position: relative;
    color: var(--text);
    display: inline-flex;
  }

  .title svg {
    height: 2em;
    width: auto;
  }

  .title::after {
    content: "> cd /";
    font-family: var(--font-mono);
    font-size: 1rem;
    text-shadow: 0 0 3px var(--primary);
    position: absolute;
    color: var(--primary);
    top: 100%;
    left: 0;
    overflow: hidden;
    white-space: nowrap;
    width: 0;
  }

  .title:hover::after {
    -webkit-text-fill-color: var(--primary);
    width: 0;
    animation: typing 1.2s forwards;
  }

  .title:hover::before {
    content: "";
    font-size: 1em;
    position: absolute;
    box-shadow: 0 0 3px var(--primary);
    background-color: var(--primary);
    top: 100%;
    left: 0;
    width: 1ch;
    height: 1lh;
    animation:
      move-cursor 1.2s forwards,
      blink 1s steps(1) 1.2s infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @keyframes typing {
    0%,
    39% {
      width: 2ch;
    }

    40%,
    59% {
      width: 3ch;
    }

    60%,
    69% {
      width: 4ch;
    }

    70%,
    99% {
      width: 5ch;
    }

    100% {
      width: 6ch;
    }
  }

  @keyframes move-cursor {
    0%,
    39% {
      transform: translateX(2ch);
    }

    40%,
    59% {
      transform: translateX(3ch);
    }

    60%,
    69% {
      transform: translateX(4ch);
    }

    70%,
    99% {
      transform: translateX(5ch);
    }

    100% {
      transform: translateX(6ch);
    }
  }
</style>
