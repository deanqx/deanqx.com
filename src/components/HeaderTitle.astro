---
import { SITE_TITLE } from "../consts";
---

<a class="title" href="/">{SITE_TITLE}</a>
<style>
  a {
    color: var(--text);
    -webkit-user-select: none;
    user-select: none;
  }
  .title {
    font-size: 1.75rem;
    font-weight: 700;
    text-decoration: none;
    position: relative;
  }
  .title:hover {
    background: linear-gradient(
      135deg,
      var(--primary),
      var(--text),
      var(--primary)
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shine 3s linear infinite;
  }
  @keyframes shine {
    to {
      background-position: 200% center;
    }
  }
  .title::after {
    content: "> cd /";
    font-family: "Sourcecode Pro", "Courier New", Courier, monospace;
    font-size: 0.7em;
    text-shadow: 0 0 3px var(--secondary);
    position: absolute;
    color: var(--secondary);
    top: 100%;
    left: 0;
    overflow: hidden;
    white-space: nowrap;
    width: 0;
  }
  .title:hover::after {
    -webkit-text-fill-color: var(--secondary);
    width: 0;
    animation: typing 1.2s forwards;
  }
  .title:hover::before {
    content: "";
    font-size: 0.7em;
    position: absolute;
    box-shadow: 0 0 3px var(--secondary);
    background-color: var(--secondary);
    top: 100%;
    left: -0.2em;
    width: 1ch;
    height: 1lh;
    animation:
      moveCursor 1.2s forwards,
      blink 1s steps(1) 1.2s infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @keyframes typing {
    0%,
    39% {
      width: 2ch;
    }
    40%,
    59% {
      width: 3ch;
    }
    60%,
    69% {
      width: 4ch;
    }
    70%,
    99% {
      width: 5ch;
    }
    100% {
      width: 6ch;
    }
  }
  @keyframes moveCursor {
    0%,
    39% {
      transform: translateX(2ch);
    }
    40%,
    59% {
      transform: translateX(3ch);
    }
    60%,
    69% {
      transform: translateX(4ch);
    }
    70%,
    99% {
      transform: translateX(5ch);
    }
    100% {
      transform: translateX(6ch);
    }
  }
</style>
