---
import HeaderLink from "./HeaderLink.astro";
import HeaderTitle from "./HeaderTitle.astro";
import houseOutline from "../assets/house_outline.svg?raw";
import houseFilled from "../assets/house_filled.svg?raw";
import moonIcon from "../assets/moon.svg?raw";
import sunIcon from "../assets/sun.svg?raw";
import githubIcon from "../assets/github.svg?raw";
---

<header>
  <nav>
    <HeaderTitle />
    <ul>
      <HeaderLink class="home" href="/">
        <Fragment slot="active-icon" set:html={houseFilled} />
        <Fragment slot="inactive-icon" set:html={houseOutline} />
      </HeaderLink>
      <HeaderLink href="/blog">Blog</HeaderLink>
      <HeaderLink href="/timeline">Timeline</HeaderLink>
    </ul>
    <div class="desktop-only nav-actions">
      <div class="icon-btn" onclick="toggleTheme()" aria-label="Toggle theme">
        <span class="moon-icon"><Fragment set:html={moonIcon} /></span>
        <span class="sun-icon"><Fragment set:html={sunIcon} /></span>
      </div>
      <a class="icon-btn" href="https://github.com/deanqx" target="_blank">
        <Fragment set:html={githubIcon} />
      </a>
    </div>
  </nav>
</header>
<style>
  header {
    padding: 0.7em 1em;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  a {
    user-select: none;
    line-height: 1;
  }

  .home {
    padding: 0.5rem;
  }

  ul {
    display: flex;
    list-style: none;
    gap: 1px;
    margin: 0;
    padding: 0.25rem;
    border-radius: 24px;
    border: var(--border);
    border-top: 1px solid var(--highlight);
    background: var(--gradient);
    box-shadow: var(--shadow);
  }

  .nav-actions,
  .nav-actions a {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .icon-btn {
    color: var(--text);
    cursor: pointer;
    width: 2.5rem;
    height: 2.5rem;
  }

  .icon-btn:hover {
    color: var(--text);
  }

  .moon-icon {
    display: block;
  }

  .sun-icon {
    display: none;
  }

  :root.dark .sun-icon {
    display: block;
  }

  :root.dark .moon-icon {
    display: none;
  }
</style>
