---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import FormattedDate from "../components/FormattedDate.astro";
import PostPreview from "../components/PostPreview.astro";
import { getEntry } from "astro:content";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

const postName = "begin";
const post = await getEntry("blog", postName);

if (!post) {
  throw new Error('Manually selected blog post "' + postName + '" not found.');
}
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <div class="indent">
        <h1>Greetings, Traveler.</h1>
        <p>
          This is where I share my latest projects and complex problems I
          encounter along the way. My goal is to save other developers a few
          hours of debugging along the way.
        </p>
        <div class="highlight-heading">
          <h2 style="border: none; margin: 0;">Highlighted Post</h2>
          <a href="/blog">View all</a>
        </div>
      </div>
      <PostPreview class="post-preview" post={post} />
    </main>
    <Footer />
  </body>
</html>

<style>
  .highlight-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 2.25rem;
    margin-bottom: 1.25rem;
  }
  @media (max-width: 720px) {
    main {
      padding: 0;
    }
    .indent {
      padding: 1rem;
    }
  }
</style>
