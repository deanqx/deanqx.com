---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { getEntry } from "astro:content";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

const postName = "begin";
const post = await getEntry("blog", postName);

if (!post) {
  throw new Error('Manually selected blog post "' + postName + '" not found.');
}
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <h1>Greetings, Traveler.</h1>
      <p>
        This is where I share my latest projects and complex problems I
        encounter along the way. My goal is to save other developers a few hours
        of debugging along the way.
      </p>
      <div
        style="display: flex; justify-content: space-between; align-items: center;"
      >
        <h2>Highlighted Post</h2>
        <a href="/blog">View all</a>
      </div>
      <article class="post-preview">
        <a class="title" href={`/blog/${post.id}/`}>{post.data.title}</a>
        <p class="date">
          <FormattedDate date={post.data.pubDate} />
        </p>
        <p class="description">{post.data.description}</p>
      </article>
    </main>
    <Footer />
  </body>
</html>
<style>
  h2 {
    border: none;
  }
  .post-preview {
    break-inside: avoid;
    padding: 1em;
    margin-bottom: 0.7em;
    border-radius: 12px;
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-size) var(--border-color);
    background-color: var(--bg-overlay);
  }
  .title {
    text-decoration: none;
    font-size: 1.2em;
    color: var(--text-p);
  }
  .date {
    color: var(--text-muted);
  }
  .title:hover {
    text-decoration: underline;
    color: var(--text);
  }
  .description {
    color: var(--text-muted);
    margin: 0;
  }
</style>
